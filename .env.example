# Copy to .env (never commit .env). Leave secrets empty here.
HONEYPASS_MODE=local                 # local | aws
HONEYPASS_SANDBOX=local              # local | docker | agentcore
HONEYPASS_BEDROCK_MODEL_ID=          # Bedrock model id or inference profile for the Detention Room agent
HONEYPASS_KMS_KEY_ID=                # aws mode only: asymmetric ECC_NIST_P256 key
HONEYPASS_TABLE_NAME=honeypass-passports
HONEYPASS_TRACE_BUCKET=
HONEYPASS_SINK_URL=http://127.0.0.1:8787/sink
AWS_REGION=us-east-1
AWS_PROFILE=
